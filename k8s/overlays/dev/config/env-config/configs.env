# [PostgreSQL] - infra & spot
DB_NAME=spot_db

# [Redis] - spot
SPRING_DATA_REDIS_PORT=6379

# [Kafka] - spot
KAFKA_BOOTSTRAP_SERVERS=kafka-cluster-kafka-bootstrap.infra.svc.cluster.local:9092

# [Temporal] - infra & spot
SPRING_TEMPORAL_CONNECTION_TARGET=temporal.infra.svc.cluster.local:7233

# [JWT] - spot
SPRING_JWT_EXPIRE_MS=3600000

# [TOSS] - spot
TOSS_CUSTOMER_KEY=customer_1

# [Feign] - spot
FEIGN_USER_URL=http://spot-user:8081
FEIGN_ORDER_URL=http://spot-order:8082
FEIGN_STORE_URL=http://spot-store:8083
FEIGN_PAYMENT_URL=http://spot-payment:8084

SPOT_USER_URI=http://spot-user:8081
SPOT_STORE_URI=http://spot-store:8083
SPOT_ORDER_URI=http://spot-order:8082
SPOT_PAYMENT_URI=http://spot-payment:8084