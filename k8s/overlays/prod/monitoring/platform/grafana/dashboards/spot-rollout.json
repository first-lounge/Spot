{
  "uid": "spot-rollout",
  "title": "Spot Rollout (Blue/Green)",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-10m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spot-Gateway",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "label_replace(sum by (pod) (rate(http_server_requests_seconds_count{namespace=\"spot\", service=\"spot-gateway\"}[30s])), \"version\", \"$1\", \"pod\", \"spot-gateway-([^-]+)-.*\")",
          "interval": "5s",
          "legendFormat": "{{version}}",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ]
}
