    {
      "type": "stat",
      "title": "에러율 (4xx+5xx)",
      "description": "gateway가 응답한 요청 중 4xx·5xx 비율(최근 값). /actuator(probe) 제외.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(max without (job, service) (rate(http_server_requests_seconds_count{namespace=\"spot\", uri!~\"/actuator.*\", container=\"spot-gateway\", status=~\"[45]..\"}[$__rate_interval]))) / sum(max without (job, service) (rate(http_server_requests_seconds_count{namespace=\"spot\", uri!~\"/actuator.*\", container=\"spot-gateway\"}[$__rate_interval])))",
          "legendFormat": "에러율",
          "refId": "A",
          "range": true
        }
      ]
    },
